# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 构建产物（tools/package_smoke.py / pip wheel 会在仓库根建这两个目录）
build/
dist/

# 运行输出：保留 acceptance 与显式指定的实例，其余临时运行不纳入版本管理
runs/*
!runs/acceptance/
!runs/.gitkeep

# 界面探针的临时运行目录（tools/ui_probe.py、tools/ui_demo_probe.py 每次重跑都会重建）
runs/acceptance/_ui_probe/
runs/acceptance/_ui_demo_probe/
runs/_ui_probe/
runs/_ui_demo_probe/

# Streamlit 本地配置
.streamlit/

# 本地启动日志（streamlit run 重定向输出）
_streamlit.log
*.log

# 本地临时输出（测试 / 诊断重定向到仓库根目录的临时文件）
/_*.txt
/_*.tar

# 编辑器
.vscode/
.idea/
*.swp
