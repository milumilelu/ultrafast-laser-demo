  "purpose": "七类材料经验几何求解器demo的证据与材料卡模板；不是现有TTM程序可直接加载的配置。",
  "scope": "表面净去除、浅坑、开放沟槽和栅格面扫描；不保证深孔、裂纹、分层、再沉积、LIPSS或高保真温度。",
  "global_rules": [
    "缺失数值保持null；不得由材料名称自动填充。",
    "单脉冲、N脉冲及加工有效阈值是不同类型。",
    "引用的Fth原则上按文献入射峰值定义；启用前核对源文能流定义与求解器一致。",
    "材料卡按波长、脉宽、材料形态、照射历史分版本。",
    "多脉冲累计拟合与逐脉冲递推不自动等价，必须先做对应文献工况复现。",
    "归一化演示的深度单位为delta_ref，不能标成真实μm。",
    "复合材料相分布若由随机生成，必须标记synthetic_microstructure。",
    "热物性是备用数据，不表示已经具备温度或HAZ预测能力。"
  ],
  "normalized_demo": {
    "allowed": true,
    "explicit_user_selection_required": true,
    "fluence_unit": "F_ref",
    "depth_unit": "delta_ref",
    "F_ref": 1.0,
    "delta_ref": 1.0,
    "parameters_are_physical_material_values": false,
    "warning": "只验证求解流程、几何与界面，不能据此比较七种材料真实加工速度。"
